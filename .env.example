# Copy this file to .env and set strong random values.
# For production, never use default fallback values from server.js.

SESSION_SECRET=replace-with-long-random-session-secret
NODERED_CREDENTIAL_SECRET=replace-with-long-random-nodered-secret
# 32-byte key encoded as hex (64 characters) or base64.
MQTT_ENCRYPTION_KEY=replace-with-64-character-hex-key
# Secret key matching mobile SWOLF Auth / external JWT signer.
JWT_SECRET=replace-with-jwt-secret-key
NODE_ENV=production
